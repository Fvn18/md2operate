#!/bin/sh
# =============================================================================
#  md2pdf —— Markdown → PDF 转换器 (macOS / POSIX sh)
#
#  依赖 : pandoc (必需) + xelatex | lualatex | tectonic | pdflatex (其一)
#  可选 : fc-list(字体探测) qpdf(PDF 校验) fswatch(监听优化)
#
#  安装 : ./install.sh          # 软链到 ~/.local/bin，并写入 ~/.zshrc
#  帮助 : md2pdf -h
# =============================================================================
set -u

PROG=${0##*/}
VERSION='1.0.0'
NL='
'

# --------------------------------------------------------------- 路径解析 ----
_resolve() {
    _rp=$1
    while [ -L "$_rp" ]; do
        _rd=$(cd -P "$(dirname "$_rp")" >/dev/null 2>&1 && pwd) || return 1
        _rp=$(readlink "$_rp")
        case $_rp in /*) ;; *) _rp=$_rd/$_rp ;; esac
    done
    _rd=$(cd -P "$(dirname "$_rp")" >/dev/null 2>&1 && pwd) || return 1
    printf '%s/%s\n' "$_rd" "${_rp##*/}"
}
SELF=$(_resolve "$0") || SELF=$0
MD2PDF_HOME=${MD2PDF_HOME:-$(dirname "$SELF")}
export MD2PDF_HOME

# ------------------------------------------------------------------ 颜色 -----
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    C_R=$(printf '\033[31m'); C_G=$(printf '\033[32m'); C_Y=$(printf '\033[33m')
    C_B=$(printf '\033[36m'); C_D=$(printf '\033[2m');  C_0=$(printf '\033[0m')
else
    C_R=; C_G=; C_Y=; C_B=; C_D=; C_0=
fi

QUIET=0; VERBOSE=0
info() { [ "$QUIET" = 1 ] || printf '%s\n' "$*" >&2; }
note() { [ "$QUIET" = 1 ] || printf '%s▸%s %s\n' "$C_B" "$C_0" "$*" >&2; }
warn() { printf '%swarn:%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
err()  { printf '%serror:%s %s\n' "$C_R" "$C_0" "$*" >&2; }
dbg()  { [ "$VERBOSE" = 1 ] && printf '%sdebug:%s %s\n' "$C_D" "$C_0" "$*" >&2; return 0; }
die()  { err "$1"; exit "${2:-1}"; }

# --------------------------------------------------------------- 依赖检测 ----
have() { command -v "$1" >/dev/null 2>&1; }

hash_str() {
    if   have md5;    then md5 -q
    elif have md5sum; then md5sum | awk '{print $1}'
    else cksum | awk '{print $1 "-" $2}'; fi
}
hash_file() { hash_str < "$1"; }

# 是否含 CJK (UTF-8 前导字节 E4–E9)；检测不了则保守返回"有"
has_cjk() {
    [ -f "$1" ] || return 1
    _pat=$(printf '[\344-\351]')
    LC_ALL=C grep -q "$_pat" "$1" 2>/dev/null
}

font_exists() {
    have fc-list || return 0
    fc-list : family 2>/dev/null | tr ',' "$NL" \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | grep -Fxi -- "$1" >/dev/null 2>&1
}

pick_cjk_font() {
    # macOS: PingFang SC 自 10.11 起为内置字体，由 CoreText 解析
    # （fontconfig 往往看不到它，因此这里不做 fc-list 探测）
    if [ "$(uname -s)" = Darwin ]; then
        printf '%s\n' 'PingFang SC'
        return 0
    fi
    for _f in "Noto Sans CJK SC" "Source Han Sans SC" "WenQuanYi Micro Hei" \
              "Microsoft YaHei" "SimSun" "Songti SC"; do
        font_exists "$_f" && { printf '%s\n' "$_f"; return 0; }
    done
    printf '%s\n' "Noto Sans CJK SC"
}

find_pandoc() {
    have pandoc || die "未找到 pandoc。安装: brew install pandoc" 2
    PANDOC=$(command -v pandoc)
    PANDOC_VER=$("$PANDOC" --version 2>/dev/null | head -1 | awk '{print $2}')
    [ -n "$PANDOC_VER" ] || PANDOC_VER='?'
}

engine_family() {
    case $1 in
        xelatex|lualatex|pdflatex|latex|tectonic|latexmk) echo latex ;;
        wkhtmltopdf|weasyprint|prince)                    echo html  ;;
        typst)                                            echo typst ;;
        *)                                                echo other ;;
    esac
}

pick_engine() {
    if [ -n "$O_ENGINE" ]; then printf '%s\n' "$O_ENGINE"; return; fi
    if [ -n "${MD2PDF_ENGINE:-}" ]; then printf '%s\n' "$MD2PDF_ENGINE"; return; fi
    if [ "$TO" = pdf ]; then
        for _e in xelatex lualatex tectonic pdflatex; do
            have "$_e" && { printf '%s\n' "$_e"; return; }
        done
        die "未找到 PDF 引擎。安装: brew install --cask mactex-no-gui  或  brew install tectonic" 2
    fi
    printf '%s\n' xelatex
}

# --------------------------------------------------------------- 质量档位 ----
preset_load() {
    P_INCLUDE=''
    case $1 in
    draft|fast|q0)
        P_DESC='极速草稿'
        P_FONTSIZE=10pt; P_MARGIN=0.8in; P_LINESTRETCH=1.0; P_TOC=0; P_TOCDEPTH=2
        P_NUMBERS=0; P_COLORLINKS=0; P_DOCCLASS=article; P_CLASSON=''
        P_HIGHLIGHT=kate; P_GEOM_EXTRA='' ;;
    std|standard|normal|q1)
        P_DESC='标准(默认)'
        P_FONTSIZE=11pt; P_MARGIN=1.2in; P_LINESTRETCH=''; P_TOC=0; P_TOCDEPTH=2
        P_NUMBERS=1; P_COLORLINKS=0; P_DOCCLASS=article; P_CLASSON=''
        P_HIGHLIGHT=tango; P_GEOM_EXTRA='' ;;
    high|hq|q2)
        P_DESC='高质量论文'
        P_FONTSIZE=11pt; P_MARGIN=1.0in; P_LINESTRETCH=1.25; P_TOC=1; P_TOCDEPTH=3
        P_NUMBERS=1; P_COLORLINKS=1; P_DOCCLASS=article; P_CLASSON=''
        P_HIGHLIGHT=tango; P_GEOM_EXTRA='headheight=15pt' ;;
    press|print|q3)
        P_DESC='印刷排版(双面)'
        P_FONTSIZE=12pt; P_MARGIN=1.0in; P_LINESTRETCH=1.3; P_TOC=1; P_TOCDEPTH=2
        P_NUMBERS=1; P_COLORLINKS=2; P_DOCCLASS=article; P_CLASSON=twoside
        P_HIGHLIGHT=tango
        P_GEOM_EXTRA='bindingoffset=0.2in,headheight=16pt'
        [ -f "$MD2PDF_HOME/includes/press.tex" ] && P_INCLUDE="$MD2PDF_HOME/includes/press.tex" ;;
    cn|paper|thesis|q4)
        P_DESC='中文论文 (ctex)'
        P_FONTSIZE=''; P_MARGIN=1.1in; P_LINESTRETCH=''; P_TOC=1; P_TOCDEPTH=2
        P_NUMBERS=1; P_COLORLINKS=1; P_DOCCLASS=ctexart; P_CLASSON='zihao=-4'
        P_HIGHLIGHT=tango; P_GEOM_EXTRA='' ;;
    screen|web|ebook|q5)
        P_DESC='屏幕阅读'
        P_FONTSIZE=11pt; P_MARGIN=0.9in; P_LINESTRETCH=1.35; P_TOC=1; P_TOCDEPTH=3
        P_NUMBERS=1; P_COLORLINKS=1; P_DOCCLASS=article; P_CLASSON=''
        P_HIGHLIGHT=tango; P_GEOM_EXTRA='' ;;
    slides|beamer|q6)
        P_DESC='Beamer 幻灯片'
        P_FONTSIZE=''; P_MARGIN=''; P_LINESTRETCH=''; P_TOC=0; P_TOCDEPTH=2
        P_NUMBERS=0; P_COLORLINKS=1; P_DOCCLASS=beamer; P_CLASSON=''
        P_HIGHLIGHT=tango; P_GEOM_EXTRA='' ;;
    *) die "未知质量档位: $1  (可用: $(preset_names | tr '\n' ' '))" 1 ;;
    esac
}

preset_names() { printf 'draft\nstd\nhigh\npress\ncn\nscreen\nslides\n'; }

preset_aliases() {
    case $1 in
    draft)  printf 'fast q0' ;;
    std)    printf 'standard normal q1' ;;
    high)   printf 'hq q2' ;;
    press)  printf 'print q3' ;;
    cn)     printf 'paper thesis q4' ;;
    screen) printf 'web ebook q5' ;;
    slides) printf 'beamer q6' ;;
    esac
}

json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cmd_list() {
    # ---- JSON 输出：供网页工作台 / mdp CLI / 脚本消费，是档位的唯一事实来源 ----
    if [ "${JSON_OUT:-0}" = 1 ]; then
        printf '{"version":"%s","defaultQuality":"%s","engine":"%s","pandoc":"%s","rasterizer":"%s","targets":["pdf","png","html","docx","tex","epub","pptx"],"presets":[' \
            "$(json_esc "$VERSION")" "$(json_esc "${MD2PDF_QUALITY:-std}")" \
            "$(json_esc "$(pick_engine)")" "$(json_esc "$PANDOC_VER")" "$(pick_raster_tool)"
        _first=1
        for p in $(preset_names); do
            preset_load "$p"
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '{"id":"%s","aliases":"%s","desc":"%s","fontsize":"%s","margin":"%s","linestretch":"%s","toc":%s,"tocDepth":%s,"numbers":%s,"colorlinks":%s,"documentclass":"%s","classoption":"%s","highlight":"%s","geomExtra":"%s","include":"%s","beamer":%s}' \
                "$p" "$(preset_aliases "$p")" "$(json_esc "$P_DESC")" \
                "$(json_esc "$P_FONTSIZE")" "$(json_esc "$P_MARGIN")" "$(json_esc "$P_LINESTRETCH")" \
                "$([ "$P_TOC" = 1 ] && echo true || echo false)" "$P_TOCDEPTH" \
                "$([ "$P_NUMBERS" = 1 ] && echo true || echo false)" "${P_COLORLINKS:-0}" \
                "$(json_esc "$P_DOCCLASS")" "$(json_esc "$P_CLASSON")" "$(json_esc "$P_HIGHLIGHT")" \
                "$(json_esc "$P_GEOM_EXTRA")" "$(json_esc "$P_INCLUDE")" \
                "$([ "$P_DOCCLASS" = beamer ] && echo true || echo false)"
        done
        printf '],"engines":['
        _first=1
        for _e in xelatex lualatex tectonic pdflatex weasyprint wkhtmltopdf typst; do
            if have "$_e"; then
                [ "$_first" = 1 ] || printf ','
                _first=0
                printf '"%s"' "$_e"
            fi
        done
        printf ']}\n'
        exit 0
    fi

    printf '\n%s质量档位%s   (引擎 %s%s%s · pandoc %s)\n\n' "$C_B" "$C_0" "$C_G" "$(pick_engine)" "$C_0" "$PANDOC_VER"
    printf '  %-8s %-7s %-8s %-5s %-5s %-11s %s\n' 档位 字号 页边距 TOC NUM STYLE 说明
    printf '  %s\n' '----------------------------------------------------------------------------'
    for p in $(preset_names); do
        preset_load "$p"
        printf '  %-8s %-7s %-8s %-5s %-5s %-11s %s\n' \
            "$p" "${P_FONTSIZE:--}" "${P_MARGIN:--}" \
            "$([ "$P_TOC" = 1 ] && echo Y || echo -)" \
            "$([ "$P_NUMBERS" = 1 ] && echo Y || echo -)" \
            "$P_HIGHLIGHT" "$P_DESC"
    done
    printf '\n  %sTOC=目录  NUM=章节编号  STYLE=代码高亮%s\n' "$C_D" "$C_0"
    printf '  %s输出目标%s  pdf(默认) · png(--dpi 300 高清位图) · tex · html · docx\n' "$C_D" "$C_0"
    printf '  %s栅格化%s    %s\n' "$C_D" "$C_0" "$(pick_raster_tool)"
    printf '  %s示例%s  md2pdf -q high 论文.md      md2pdf -t png --dpi 300 图.md\n' "$C_D" "$C_0"
    printf '  %s网页%s  md2pdf serve\n\n' "$C_D" "$C_0"
    exit 0
}

